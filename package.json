{
  "name": "node-lockfile-doctor-kit",
  "version": "0.1.0",
  "description": "Inspect Node package-manager lockfile consistency with structured diagnostics.",
  "keywords": [
    "node",
    "lockfile",
    "doctor",
    "npm",
    "pnpm",
    "yarn",
    "bun",
    "diagnostics",
    "package-manager",
    "typescript",
    "browser",
    "developer-tools"
  ],
  "type": "module",
  "sideEffects": false,
  "license": "MPL-2.0",
  "author": "Recoveredd",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Recoveredd/node-lockfile-doctor-kit.git"
  },
  "bugs": {
    "url": "https://github.com/Recoveredd/node-lockfile-doctor-kit/issues"
  },
  "homepage": "https://github.com/Recoveredd/node-lockfile-doctor-kit#readme",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "node-lockfile-doctor": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "typescript": "^5.9.3",
    "vitest": "^1.6.1"
  }
}
